# Copy to .env and fill in. Never commit .env.

# --- Databases -------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=insaaf
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please          # also used by docker-compose

# --- LLMs: local by default (Ollama) ---------------------------------------
#   ollama pull gpt-oss:20b && ollama pull llama3.1:8b && ollama pull nomic-embed-text
CHAT_PROVIDER=openai                     # openai = any OpenAI-compatible server (Ollama, vLLM, Groq…)
CHAT_MODEL=gpt-oss:20b
EXTRACT_PROVIDER=openai
EXTRACT_MODEL=llama3.1:8b
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

EMBED_MODEL=nomic-embed-text
EMBED_DIM=768                            # must match the model; changing it requires re-indexing

# --- Or use Claude ----------------------------------------------------------
# CHAT_PROVIDER=anthropic
# CHAT_MODEL=claude-opus-5-5
# EXTRACT_PROVIDER=anthropic
# EXTRACT_MODEL=claude-haiku-5-5         # cheaper model for bulk case-note extraction
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_CHAT_EFFORT=high
# ANTHROPIC_EXTRACT_EFFORT=low
# ANTHROPIC_REFUSAL_FALLBACK=true        # server-side fallback if a request is declined

# --- Indian Kanoon -----------------------------------------------------------
# Optional official API token (api.indiankanoon.org) — preferred for bulk ingestion.
# KANOON_API_TOKEN=
SCRAPER_RATE_PER_S=0.5                   # be polite: one request every 2 s
SCRAPER_CONCURRENCY=2

# --- API ---------------------------------------------------------------------
# JSON list. Empty = no auth (local dev only).
API_KEYS=[]
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
LOG_JSON=false
